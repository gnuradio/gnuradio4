{
  "version": 6,
  "configurePresets": [
    {
      "name": "dev-mac",
      "inherits": "dev",
      "binaryDir": "${sourceDir}/build/dev-mac",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/dev-mac",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++"
      }
    },
    {
      "name": "full-mac",
      "inherits": "full",
      "binaryDir": "${sourceDir}/build/full-mac",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/full-mac",
        "CMAKE_C_COMPILER": "/opt/homebrew/opt/llvm/bin/clang",
        "CMAKE_CXX_COMPILER": "/opt/homebrew/opt/llvm/bin/clang++",
        "GR4_BLOCKS_CMAKE_ARGS": "-DGR4_ENABLE_ZEROMQ=ON;-DGR4_ENABLE_SDR=ON;-DGR4_ENABLE_AUDIO=ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-mac",
      "configurePreset": "dev-mac",
      "jobs": 0
    },
    {
      "name": "full-mac",
      "configurePreset": "full-mac",
      "jobs": 0
    }
  ]
}
